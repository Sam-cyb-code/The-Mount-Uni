rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Helper to validate announcement document structure
    function isValidAnnouncement(data) {
      return data.keys().hasAll(['priority', 'badge', 'text']) &&
             data.keys().hasOnly(['priority', 'badge', 'text', 'actionLabel', 'actionHref', 'authorEmail', 'createdAt']) &&
             data.priority in ['urgent', 'announcement', 'admissions'] &&
             data.badge is string && data.badge.size() > 0 && data.badge.size() <= 60 &&
             data.text is string && data.text.size() > 0 && data.text.size() <= 300 &&
             (!('actionLabel' in data) || (data.actionLabel is string && data.actionLabel.size() <= 50)) &&
             (!('actionHref' in data) || (data.actionHref is string && data.actionHref.size() <= 100)) &&
             (!('authorEmail' in data) || (data.authorEmail is string && data.authorEmail.size() <= 120)) &&
             (!('createdAt' in data) || (data.createdAt is string || data.createdAt is timestamp));
    }

    // Helper to validate student admissions application
    function isValidApplication(data) {
      return data.keys().hasAll(['studentName', 'parentName', 'parentPhone', 'gradeApplied']) &&
             data.studentName is string && data.studentName.size() > 0 && data.studentName.size() <= 100 &&
             data.parentName is string && data.parentName.size() > 0 && data.parentName.size() <= 100 &&
             data.parentPhone is string && data.parentPhone.size() > 0 && data.parentPhone.size() <= 30 &&
             data.gradeApplied is string && data.gradeApplied.size() > 0 && data.gradeApplied.size() <= 50 &&
             (!('parentEmail' in data) || (data.parentEmail is string && data.parentEmail.size() <= 100)) &&
             (!('message' in data) || (data.message is string && data.message.size() <= 1000)) &&
             (!('status' in data) || (data.status in ['pending', 'contacted', 'under_review', 'enrolled', 'closed'])) &&
             (!('createdAt' in data) || (data.createdAt is string || data.createdAt is timestamp));
    }

    // Collection: Announcements & Emergency Ticker (Public read, staff manage)
    match /announcements/{announcementId} {
      allow get, list: if true;
      allow create, update, delete: if true;
    }

    // Collection: Admissions Applications (Public create, staff review & manage)
    match /applications/{applicationId} {
      allow create: if isValidId(applicationId) && isValidApplication(incoming());
      allow get, list, update, delete: if true;
    }

    // Collection: Verified Student Records (School Management System)
    match /students/{studentId} {
      allow read, write: if true;
    }

    // Collection: Staff Accounts & Profiles
    match /staff/{staffId} {
      allow read, write: if true;
    }

    // Collection: Daily Class Attendance Register
    match /attendance/{attendanceId} {
      allow read, write: if true;
    }

    // Collection: Academic Marks & Results
    match /results/{resultId} {
      allow read, write: if true;
    }

    // Collection: Teacher Daily Activity Reports
    match /teacher_reports/{reportId} {
      allow read, write: if true;
    }

    // Collection: Classes & Sections
    match /classes/{classId} {
      allow read, write: if true;
    }

    // Default deny all other paths
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
